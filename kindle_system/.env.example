# Kindle System 環境変数設定ファイル
#
# start_prod.bat（npm run build → python src/server.py）で直接実行する際に、
# 必要であればこのファイルを .env という名前でコピーして値を編集してください。
# コピー方法: copy .env.example .env
# どちらも任意設定です。未設定でも Windows 上でそのまま動作します。
#
# KINDLE_XML_PATH:
#   Kindle for PC のキャッシュファイル（KindleSyncMetadataCache.xml）のフルパス。
#   未設定の場合は %LOCALAPPDATA%\Amazon\Kindle\Cache\KindleSyncMetadataCache.xml が使われます。
#   標準的な場所と異なる場合のみ設定してください。
#
# KINDLE_XML_PATH=C:/Users/YourName/AppData/Local/Amazon/Kindle/Cache/KindleSyncMetadataCache.xml

# CRAWLER_PORT:
#   サーバーの待受ポート。未設定の場合は 8001 が使われます。
#
# CRAWLER_PORT=8001
