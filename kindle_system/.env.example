# Kindle System 環境変数設定ファイル
#
# python run.py sync 等で直接実行する際に、必要であればこのファイルを .env という
# 名前でコピーして値を編集してください。
# コピー方法: copy .env.example .env
# KINDLE_XML_PATH は任意設定です。未設定でも Windows 上でそのまま動作します。
# PUBLIC_SITE_DIR / PUBLIC_SITE_URL は公開機能（run.py sync 内の publish()）を
# 使う場合は必須です（下記参照）。
#
# KINDLE_XML_PATH:
#   Kindle for PC のキャッシュファイル（KindleSyncMetadataCache.xml）のフルパス。
#   未設定の場合、まず従来型インストーラー版の場所
#   （%LOCALAPPDATA%\Amazon\Kindle\Cache\KindleSyncMetadataCache.xml）を探し、
#   見つからなければ Microsoft Store（UWP）版の場所
#   （%LOCALAPPDATA%\Packages\AMZNKindle.AmazonKindleReadingApp_*\LocalState\Classic\Data\Cache\KindleSyncMetadataCache.xml）
#   を自動で探します。それでも標準的な場所と異なる場合のみ設定してください。
#
# KINDLE_XML_PATH=C:/Users/YourName/AppData/Local/Amazon/Kindle/Cache/KindleSyncMetadataCache.xml

# PUBLIC_SITE_DIR / PUBLIC_SITE_URL:
#   `python run.py sync` 内の publish()（report.py によるレポート生成 + git push）
#   で使用します。いずれも必須設定です。未設定または不正な場合は明示エラーで停止します
#   （誤ったパスへの書き込み・誤った URL を開くことを防ぐため、デフォルト値は用意しません）。
#
#   PUBLIC_SITE_DIR: GitHub Pages 公開用リポジトリをローカルにクローンした
#     ディレクトリの絶対パス（git リポジトリの作業ツリーであること）。
#     report.py はこのディレクトリ直下の wishlist.json のみを書き換えます（index.html は触りません）。
#   PUBLIC_SITE_URL: 公開後にアクセスする GitHub Pages の URL。
#
# PUBLIC_SITE_DIR=C:/Users/YourName/dev/kindle-wishlist-site
# PUBLIC_SITE_URL=https://yourname.github.io/kindle-wishlist-site/

# ローカル LLM のおすすめ（python run.py recommend）: いずれも任意設定です。
#
# LOCAL_LLM_API: ollama（デフォルト。Ollama の /api/chat）または openai
#   （LM Studio / llama.cpp server 等の OpenAI 互換 API の /v1/chat/completions）。
# LOCAL_LLM_URL: LLM サーバーの URL（デフォルト: http://localhost:11434）。
#   読書記録（見た本のタイトルと★評価）はこの URL にだけ送られます。
# LOCAL_LLM_MODEL: 使うモデル名（未設定ならサーバーに入っている最初のモデルを使う）。
#
# LOCAL_LLM_API=ollama
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=qwen2.5:7b

# PUBLISH_MARKS: 1 にすると、取り込んだ「見た」・★評価・読みたくない等のタグを公開データ
#   （wishlist.json）にも載せ、別の端末でも同じ状態が初期表示されるようにします。
#   公開の GitHub Pages に読書記録が載るため、既定（未設定）では載せません
#   （種別＝マンガ/本の切り替えだけは常に載せます）。
#
# PUBLISH_MARKS=1

# MARKS_DOWNLOAD_DIR: python run.py import-marks をファイル指定なしで実行したときに
#   最新の kindle-marks-*.json を探すフォルダ（未設定ならホームの Downloads）。
#
# MARKS_DOWNLOAD_DIR=C:/Users/YourName/Downloads
